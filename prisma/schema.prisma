generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Conversation {
  id        String   @id @default(cuid())
  title     String   @default("New Chat")
  model     String   @default("default")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  Message[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // "user" | "assistant" | "system" | "tool"
  content        String
  toolCalls      String?  // JSON string for tool calls
  toolCallId     String?  // ID linking tool response to tool call
  metadata       String?  // JSON string for extra info
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model ToolLog {
  id        String   @id @default(cuid())
  toolName  String
  input     String   // JSON
  output    String?  // JSON or text
  duration  Int?     // ms
  status    String   @default("success") // "success" | "error"
  createdAt DateTime @default(now())
}

model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model VideoJob {
  id          String   @id @default(cuid())
  mpdUrl      String
  licenseUrl  String   @default("https://cwip-shaka-proxy.appspot.com/no_auth")
  status      String   @default("pending") // pending | processing | decrypting | merging | done | error
  progress    Int      @default(0)
  message     String?
  videoPath   String?
  videoSize   Int?
  duration    Float?
  resolution  String?
  keysJson    String?   // JSON string of extracted keys
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
